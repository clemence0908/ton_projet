-- SCRIPT DE CRÉATION DE LA BASE DE DONNÉES : SMARTCAMPUS (ÉCOLE D'INGÉ)

-- =====================================================================
 
CREATE DATABASE IF NOT EXISTS smartcampus_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE smartcampus_db;
 
-- 1. TABLE DES PROMOTIONS / FILIÈRES (ex: ING1, ING2-Génie Logiciel, ING3-Cyber)

CREATE TABLE IF NOT EXISTS promotions (

    id INT AUTO_INCREMENT PRIMARY KEY,

    nom VARCHAR(100) NOT NULL, -- ex: "ING2 - Informatique (Génie Logiciel)"

    annee_academique VARCHAR(20) NOT NULL -- ex: "2025-2026"

) ENGINE=InnoDB;
 
-- 2. TABLE DES UTILISATEURS GÉNÉRIQUE (Sécurité, Authentification, Profil)

CREATE TABLE IF NOT EXISTS utilisateurs (

    id INT AUTO_INCREMENT PRIMARY KEY,

    email VARCHAR(150) NOT NULL UNIQUE,

    mot_de_pass VARCHAR(255) NOT NULL, -- Sera haché en PHP avec password_hash()

    nom VARCHAR(100) NOT NULL,

    prenom VARCHAR(100) NOT NULL,

    role ENUM('etudiant', 'enseignant', 'administrateur') NOT NULL,

    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP

) ENGINE=InnoDB;


-- 3. TABLE DES ÉTUDIANTS

CREATE TABLE IF NOT EXISTS etudiants (

    id INT AUTO_INCREMENT PRIMARY KEY,

    utilisateur_id INT NOT NULL,

    promotion_id INT NOT NULL,

    numero_etudiant VARCHAR(50) NOT NULL UNIQUE,

    date_naissance DATE,

    FOREIGN KEY (utilisateur_id) REFERENCES utilisateurs(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (promotion_id) REFERENCES promotions(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE

) ENGINE=InnoDB;


-- 4. TABLE DES ENSEIGNANTS

CREATE TABLE IF NOT EXISTS enseignants (

    id INT AUTO_INCREMENT PRIMARY KEY,

    utilisateur_id INT NOT NULL,

    specialite VARCHAR(100),

    bureau VARCHAR(50),

    FOREIGN KEY (utilisateur_id) REFERENCES utilisateurs(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE

) ENGINE=InnoDB;


-- 5. TABLE DES COURS

CREATE TABLE IF NOT EXISTS cours (

    id INT AUTO_INCREMENT PRIMARY KEY,

    nom VARCHAR(150) NOT NULL,

    description TEXT,

    semestre VARCHAR(20),

    niveau VARCHAR(50),

    capacite_max INT DEFAULT 30,

    enseignant_id INT,

    FOREIGN KEY (enseignant_id) REFERENCES enseignants(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE

) ENGINE=InnoDB;


-- 6. TABLE DES INSCRIPTIONS AUX COURS

CREATE TABLE IF NOT EXISTS inscriptions (

    id INT AUTO_INCREMENT PRIMARY KEY,

    etudiant_id INT NOT NULL,

    cours_id INT NOT NULL,

    date_inscription TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    statut ENUM('active', 'annulee') DEFAULT 'active',

    FOREIGN KEY (etudiant_id) REFERENCES etudiants(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (cours_id) REFERENCES cours(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    UNIQUE (etudiant_id, cours_id)

) ENGINE=InnoDB;


-- 7. TABLE DES NOTES

CREATE TABLE IF NOT EXISTS notes (

    id INT AUTO_INCREMENT PRIMARY KEY,

    etudiant_id INT NOT NULL,

    cours_id INT NOT NULL,

    note DECIMAL(5,2) NOT NULL,

    commentaire TEXT,

    date_saisie TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    verrouillee BOOLEAN DEFAULT FALSE,

    FOREIGN KEY (etudiant_id) REFERENCES etudiants(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (cours_id) REFERENCES cours(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CHECK (note >= 0 AND note <= 20)

) ENGINE=InnoDB;


-- 8. TABLE DES EMPLOIS DU TEMPS

CREATE TABLE IF NOT EXISTS emploi_du_temps (

    id INT AUTO_INCREMENT PRIMARY KEY,

    cours_id INT NOT NULL,

    jour ENUM('lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi') NOT NULL,

    heure_debut TIME NOT NULL,

    heure_fin TIME NOT NULL,

    salle VARCHAR(50) NOT NULL,

    FOREIGN KEY (cours_id) REFERENCES cours(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE

) ENGINE=InnoDB;


-- 9. TABLE DES NOTIFICATIONS

CREATE TABLE IF NOT EXISTS notifications (

    id INT AUTO_INCREMENT PRIMARY KEY,

    utilisateur_id INT NOT NULL,

    titre VARCHAR(150) NOT NULL,

    message TEXT NOT NULL,

    date_envoi TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    lu BOOLEAN DEFAULT FALSE,

    FOREIGN KEY (utilisateur_id) REFERENCES utilisateurs(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE

) ENGINE=InnoDB;


